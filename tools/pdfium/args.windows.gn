target_os = "win"
# PDFium's own Chromium clang-cl toolchain is used (is_clang default); the
# result is a static pdfium.lib compiled against the MSVC STL and the static CRT.

# The pinned tree is written for Chromium's libc++; with the MSVC STL some third-party-style
# warnings it promotes to errors (e.g. -Wctad-maybe-unsupported on std::less_equal) are noise.
treat_warnings_as_errors = false
