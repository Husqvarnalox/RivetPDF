// SPDX-License-Identifier: MPL-2.0
// Windows resources of rivet.exe: the application manifest (DPI awareness,
// common controls v6, UTF-8 code page) and version information.
#include <winver.h>

// Generated by CMake (configure_file). MSVC links the manifest itself
// (/MANIFESTINPUT), so the resource is only embedded for other toolchains.
#if !defined(RIVET_RC_NO_MANIFEST)
1 24 "@RIVET_WINDOWS_MANIFEST@" // CREATEPROCESS_MANIFEST_RESOURCE_ID, RT_MANIFEST
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Rivet contributors"
            VALUE "FileDescription", "Rivet"
            VALUE "FileVersion", "0.1.0"
            VALUE "LegalCopyright", "MPL-2.0"
            VALUE "OriginalFilename", "rivet.exe"
            VALUE "ProductName", "Rivet"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
